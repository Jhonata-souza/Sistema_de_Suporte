<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Sistema_Suporte_Mobile.ViewModels"
             x:Class="Sistema_Suporte_Mobile.Views.TicketDetailPage"
             Title="Detalhes do Chamado">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Título" FontAttributes="Bold"/>
            <Entry Placeholder="Digite o título"
               Text="{Binding Ticket.Title}" />

            <Label Text="Descrição" FontAttributes="Bold"/>
            <Editor Placeholder="Digite a descrição"
                Text="{Binding Ticket.Description}"
                HeightRequest="120" />

            <Button Text="Salvar Ticket"
                Command="{Binding SaveTicketCommand}" />

            <!-- Status e Data -->
            <HorizontalStackLayout Spacing="20"
                               IsVisible="{Binding Ticket.Id, Converter={StaticResource IntGreaterThanZeroConverter}}">
                <Label Text="Status:" FontAttributes="Bold"/>
                <Label Text="{Binding Ticket.Status}" />
                <Label Text="Criado em:" FontAttributes="Bold"/>
                <Label Text="{Binding Ticket.CreatedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}" />
            </HorizontalStackLayout>

            <!-- Botão Resumo IA -->
            <!--<Button Text="Gerar Resumo IA"
                Command="{Binding GenerateAiSummaryCommand}"
                IsEnabled="{Binding Ticket.Id, Converter={StaticResource IntGreaterThanZeroConverter}}" />

            <Frame BackgroundColor="#f0f0f0" Padding="10"
               IsVisible="{Binding Ticket.AiSummary, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                <Label Text="{Binding Ticket.AiSummary}" LineBreakMode="WordWrap"/>
            </Frame>-->

            <!-- Botão Resposta IA -->
            <Button Text="Gerar Resposta IA"
                Command="{Binding GenerateAiResponseCommand}"
                IsEnabled="{Binding Ticket.Id, Converter={StaticResource IntGreaterThanZeroConverter}}" />

            <Frame BackgroundColor="#f0f0f0" Padding="10"
               IsVisible="{Binding Ticket.AiResponse, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                <Label Text="{Binding Ticket.AiResponse}" LineBreakMode="WordWrap" TextColor="Black"/>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
