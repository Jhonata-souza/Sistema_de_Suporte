<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sistema_Suporte_Mobile.Views.TicketsPage"
             Title="Chamados">

    <VerticalStackLayout Padding="10">

        <Button Text="Novo Chamado"
                Command="{Binding NewTicketCommand}"/>

        <CollectionView ItemsSource="{Binding Tickets}"
                        SelectionMode="Single"
                        SelectionChanged="OnSelect">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontAttributes="Bold"/>
                            <Label Text="{Binding Status}" FontAttributes="Italic"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
